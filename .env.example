SUPABASE_URL=
SUPABASE_ANON_KEY=
API_TIMEOUT=30000
LOG_LEVEL=debug

# RC-03A - Crash Reporting (Sentry). SENTRY_DSN vazio desabilita o envio
# de eventos (comportamento nativo do SDK) - só preencher em ambientes
# com um projeto Sentry real provisionado.
SENTRY_DSN=
# development | qa | beta | production
APP_ENVIRONMENT=development
