SUPABASE_URL=
SUPABASE_ANON_KEY=
API_TIMEOUT=30000
LOG_LEVEL=debug

# RC-03A - Crash Reporting (Sentry). SENTRY_DSN vazio desabilita o envio
# de eventos (comportamento nativo do SDK) - só preencher em ambientes
# com um projeto Sentry real provisionado.
SENTRY_DSN=
# development | qa | beta | production
APP_ENVIRONMENT=development

# RC-03C - Product Analytics (PostHog). POSTHOG_API_KEY vazio desabilita
# o envio de eventos (comportamento nativo do SDK) - só preencher em
# ambientes com um projeto PostHog real provisionado. Além disso,
# eventos só saem do dispositivo fora de Development (ver AppAnalytics).
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
