<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- RC-04D: unica permissao necessaria hoje - chamadas de rede ao Supabase.
         Selecao de galeria (image_picker) e tratada pelo manifest merger do
         proprio plugin; camera, localizacao, notificacoes e armazenamento
         direto nao sao usados pelo app. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <application
        android:label="BORAH"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- RC-04E: deep link de callback da recuperação de senha
                 (borah://password-recovery). O supabase_flutter já observa
                 esse esquema automaticamente e troca o link por uma sessão -
                 nenhum código adicional é necessário além deste intent-filter.
                 Requer que o mesmo esquema esteja cadastrado em
                 Authentication → URL Configuration → Redirect URLs no
                 Supabase Dashboard (ver RC-04E_CLOSED_BETA.md). -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="borah" android:host="password-recovery"/>
            </intent-filter>
            <!-- Deep Link de convite de grupo (borah://group/join?code=X).
                 Mesmo esquema customizado já usado acima para recuperação de
                 senha - convenção domínio/ação (host/path) documentada em
                 core/deep_link/deep_link.dart. Capturado em Dart pelo pacote
                 app_links (DeepLinkService), nunca pelo supabase_flutter (que
                 só observa host=password-recovery). App Links reais
                 (https://appborah.com.br/..., com assetlinks.json verificado)
                 ficam para quando a assinatura de release final existir - ver
                 docs/release (pendência já registrada). -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="borah" android:host="group" android:path="/join"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
